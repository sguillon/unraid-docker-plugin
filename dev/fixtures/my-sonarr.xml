<?xml version="1.0"?>
<Container version="2">
  <Name>sonarr</Name>
  <Repository>lscr.io/linuxserver/sonarr:latest</Repository>
  <Network>bridge</Network>
  <Privileged>false</Privileged>
  <WebUI>http://[IP]:[PORT:8989]</WebUI>
  <Icon>https://raw.githubusercontent.com/linuxserver/docker-templates/master/linuxserver.io/img/sonarr-icon.png</Icon>
  <ExtraParams/>
  <PostArgs/>
  <Config Name="Port" Target="8989" Default="8989" Mode="tcp" Description="" Type="Port" Display="always" Required="false" Mask="false">8989</Config>
  <Config Name="Appdata" Target="/config" Default="" Mode="rw" Description="" Type="Path" Display="advanced" Required="true" Mask="false">/mnt/cache/appdata/sonarr</Config>
  <Config Name="TV" Target="/tv" Default="" Mode="rw" Description="" Type="Path" Display="always" Required="false" Mask="false">/mnt/user/TV</Config>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Description="" Type="Variable" Display="advanced" Required="true" Mask="false">99</Config>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Description="" Type="Variable" Display="advanced" Required="true" Mask="false">100</Config>
  <Config Name="TZ" Target="TZ" Default="" Mode="" Description="" Type="Variable" Display="always" Required="false" Mask="false">America/New_York</Config>
</Container>
